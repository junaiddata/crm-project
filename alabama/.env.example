SECRET_KEY=django-insecure-alabama-dev-key-change-in-production-xyz987abc
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

CRM_WEBHOOK_SECRET=change-me-to-a-random-secret

# ── WhatsApp Cloud API (direct webhook for Alabama's marketing numbers) ──
# System-user access token for Alabama's WABA/App.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token-here
# App Secret (App Dashboard → Settings → Basic) — verifies Meta's webhook signature.
WHATSAPP_APP_SECRET=your-app-secret-here
# Verify token — a string you invent; paste the SAME value into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=alabama_crm_2026
# Phone Number IDs Alabama owns (comma-separated). Also add their labels in settings.py.
WHATSAPP_PHONE_NUMBER_IDS=

DB_NAME=alabama_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
